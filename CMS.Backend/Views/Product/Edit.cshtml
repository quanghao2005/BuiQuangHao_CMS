@model CMS.Data.Entities.Product
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> CHỈNH SỬA SẢN PHẨM</h5>
        </div>
        <div class="card-body">
            @* CẦN enctype="multipart/form-data" để upload ảnh *@
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm:</label>
                            <input type="text" asp-for="Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán (Price):</label>
                            <input type="number" asp-for="Price" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng kho (StockQuantity):</label>
                            <input type="number" asp-for="StockQuantity" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả:</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Ảnh hiện tại:</label>
                        <div class="mb-3 border p-2 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 150px;" alt="Product Image" />
                            }
                            else
                            {
                                <p class="text-muted p-4">Chưa có ảnh</p>
                            }
                        </div>

                        <label class="form-label fw-bold">Thay đổi ảnh mới:</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <input type="hidden" asp-for="ImageUrl" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-warning fw-bold px-4">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>