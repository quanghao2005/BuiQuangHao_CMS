@model IEnumerable<CMS.Data.Entities.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-dark">QUẢN LÝ SẢN PHẨM</h3>
        <a href="/Product/Create" class="btn btn-success rounded-pill"><i class="bi bi-plus-lg"></i> Thêm Sản Phẩm</a>
    </div>

    <table class="table table-bordered table-hover bg-white shadow-sm text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình Ảnh</th>
                <th>Tên Sản Phẩm</th>
                <th>Giá Bán</th>
                <th>Số Lượng Kho</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>
                            @* Hiển thị ảnh: Nếu chưa có ảnh thì dùng ảnh mặc định *@
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.png" : p.ImageUrl)"
                                 alt="@p.Name"
                                 class="img-thumbnail"
                                 style="width: 60px; height: 60px; object-fit: cover;" />
                        </td>
                        <td class="fw-bold text-primary">@p.Name</td>
                        <td>@p.Price.ToString("N0") đ</td>
                        <td>@p.StockQuantity</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/Product/Edit/@p.Id" class="btn btn-sm btn-warning rounded-pill px-3">Sửa</a>
                                <form action="/Product/Delete/@p.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Hiển thị phân trang -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3 me-2" href="/Product/Index?page=@(ViewBag.CurrentPage - 1)">Trước</a>
                </li>
                
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link rounded-circle mx-1" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" href="/Product/Index?page=@i">@i</a>
                    </li>
                }
                
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3 ms-2" href="/Product/Index?page=@(ViewBag.CurrentPage + 1)">Tiếp</a>
                </li>
            </ul>
        </nav>
    }
</div>