@model CMS.Data.Entities.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cập nhật đơn hàng #" + Model.Id;
}

<div class="container mt-4">
    <div class="card shadow" style="max-width: 650px; margin: 0 auto;">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> CẬP NHẬT THÔNG TIN ĐƠN HÀNG #@Model.Id</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OrderDate" /> <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label fw-bold">Khách hàng đặt đơn</label>
                    <select asp-for="CustomerId" class="form-select" required>
                        @if (ViewBag.Customers != null)
                        {
                            foreach (var cust in ViewBag.Customers)
                            {
                                <option value="@cust.Id">Mã KH: @cust.Id - @(cust.GetType().GetProperty("Name") != null ? cust.Name : (cust.GetType().GetProperty("FullName") != null ? cust.FullName : "Khách hàng"))</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái xử lý</label>
                    <select asp-for="Status" class="form-select">
                        <option value="0">0: Chờ duyệt (Hệ thống tiếp nhận)</option>
                        <option value="1">1: Đang giao (Đã đóng gói hàng)</option>
                        <option value="2">2: Đã xong (Hoàn tất giao dịch)</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label fw-bold">Ghi chú nội bộ</label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Nhập ghi chú giao đơn, thông tin thêm..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/Order" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning fw-bold">Cập nhật ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>