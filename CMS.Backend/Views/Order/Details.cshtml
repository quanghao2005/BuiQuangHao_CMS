@model CMS.Data.Entities.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    
    decimal total = 0;
    if (Model.OrderDetails != null)
    {
        total = Model.OrderDetails.Sum(x => x.Quantity * x.UnitPrice);
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-dark fw-bold mb-0">
            <i class="bi bi-receipt"></i> CHI TIẾT ĐƠN HÀNG #@Model.Id
        </h4>
        <a href="/Order" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay Lại</a>
    </div>

    <div class="row">
        <!-- Thông Tin Khách Hàng -->
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-person-lines-fill"></i> THÔNG TIN KHÁCH HÀNG
                </div>
                <div class="card-body">
                    @if (Model.Customer != null)
                    {
                        <p><strong>Họ và tên:</strong> @Model.Customer.FullName</p>
                        <p><strong>Số điện thoại:</strong> @Model.Customer.Phone</p>
                        <p><strong>Email:</strong> @Model.Customer.Email</p>
                        <p><strong>Địa chỉ giao:</strong> @Model.Customer.Address</p>
                    }
                    else
                    {
                        <p class="text-muted">Không tìm thấy thông tin khách hàng</p>
                    }
                    <hr />
                    <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Ghi chú đơn:</strong> <span class="text-danger">@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</span></p>
                </div>
            </div>
        </div>

        <!-- Cập Nhật Trạng Thái Nhanh -->
        <div class="col-md-8 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="bi bi-truck"></i> TRẠNG THÁI GIAO HÀNG
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="mb-4 text-center">
                        <h5>Trạng thái hiện tại: 
                            @if (Model.Status == 0)
                            {
                                <span class="badge bg-warning text-dark fs-5 p-2 mt-2 d-inline-block">Chờ duyệt (Tiếp nhận)</span>
                            }
                            else if (Model.Status == 1)
                            {
                                <span class="badge bg-primary fs-5 p-2 mt-2 d-inline-block">Đang giao hàng</span>
                            }
                            else if (Model.Status == 2)
                            {
                                <span class="badge bg-success fs-5 p-2 mt-2 d-inline-block">Đã hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-5 p-2 mt-2 d-inline-block">Đã hủy</span>
                            }
                        </h5>
                    </div>

                    <form asp-action="UpdateStatus" method="post" class="border p-3 rounded bg-light">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <select name="status" class="form-select fw-bold border-secondary" style="height: 45px;">
                                    <!option value="0" @(Model.Status == 0 ? "selected" : "")>0: Chờ duyệt (Hệ thống tiếp nhận)</!option>
                                    <!option value="1" @(Model.Status == 1 ? "selected" : "")>1: Đang giao (Đã đóng gói hàng)</!option>
                                    <!option value="2" @(Model.Status == 2 ? "selected" : "")>2: Đã xong (Hoàn tất giao dịch)</!option>
                                </select>
                            </div>
                            <div class="col-md-4 mt-3 mt-md-0">
                                <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm" style="height: 45px;">
                                    <i class="bi bi-check-circle"></i> XÁC NHẬN ĐỔI
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh Sách Sản Phẩm (OrderDetails) -->
    <div class="card shadow mb-5">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="bi bi-list-check"></i> SẢN PHẨM ĐÃ ĐẶT (ORDER DETAILS)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-3">Mã SP</th>
                            <th>Đơn Giá</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end pe-3">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">SP-@item.ProductId</td>
                                    <td>@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-center fw-bold text-primary">x @item.Quantity</td>
                                    <td class="text-end pe-3 text-danger fw-bold">
                                        @((item.Quantity * item.UnitPrice).ToString("N0")) ₫
                                    </td>
                                </tr>
                            }
                            <tr class="table-light border-top border-2 border-dark">
                                <td colspan="3" class="text-end fw-bold fs-5 pt-3">TỔNG CỘNG:</td>
                                <td class="text-end pe-3 fw-bold fs-5 text-danger pt-3">@total.ToString("N0") ₫</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Không tìm thấy chi tiết sản phẩm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
