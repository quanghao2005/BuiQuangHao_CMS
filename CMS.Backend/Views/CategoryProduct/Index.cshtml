@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-dark fw-bold"><i class="bi bi-tags-fill"></i> QUẢN LÝ DANH MỤC SẢN PHẨM</h4>
        <a href="/CategoryProduct/Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle-fill"></i> Thêm danh mục mới
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;" class="text-center">Mã ID</th>
                        <th>Tên danh mục sản phẩm</th>
                        <th>Mô tả chi tiết</th>
                        <th style="width: 200px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td class="text-primary fw-bold">@item.Name</td>
                                <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả" : item.Description)</td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/CategoryProduct/Edit/@item.Id" class="btn btn-sm btn-warning fw-bold">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>

                                        <form action="/CategoryProduct/Delete/@item.Id" method="post"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?');" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Hiện tại chưa có dữ liệu danh mục sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>