@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh m?c s?n ph?m";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-dark fw-bold"><i class="bi bi-tags-fill"></i> QU?N LÝ DANH M?C S?N PH?M</h4>
        <a href="/CategoryProduct/Create" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle-fill"></i> Thêm danh m?c m?i
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;" class="text-center">Mã ID</th>
                        <th>Tên danh m?c s?n ph?m</th>
                        <th>Mô t? chi ti?t</th>
                        <th style="width: 200px;" class="text-center">Hành d?ng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td class="text-primary fw-bold">@item.Name</td>
                                <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "Chua có mô t?" : item.Description)</td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/CategoryProduct/Edit/@item.Id" class="btn btn-sm btn-warning fw-bold">
                                            <i class="bi bi-pencil-square"></i> S?a
                                        </a>

                                        <form action="/CategoryProduct/Delete/@item.Id" method="post"
                                              onsubmit="return confirm('B?n có ch?c ch?n mu?n xóa danh m?c này không?');" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Hi?n t?i chua có d? li?u danh m?c s?n ph?m nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
