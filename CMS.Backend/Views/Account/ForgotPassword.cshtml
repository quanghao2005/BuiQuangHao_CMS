@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Quên mật khẩu - HaoCMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow p-4" style="width: 400px; border-radius: 12px;">
        <h4 class="text-center fw-bold mb-4">Khôi phục mật khẩu</h4>
        
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/ForgotPassword">
            <div class="mb-3">
                <label>Tên đăng nhập</label>
                <input type="text" name="username" class="form-control" required />
            </div>
            <div class="mb-4">
                <label>Email liên kết</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold">GỬI YÊU CẦU</button>
        </form>
        <div class="text-center mt-3">
            <a href="/Account/Login" class="text-decoration-none">Quay lại đăng nhập</a>
        </div>
    </div>
</body>
</html>
