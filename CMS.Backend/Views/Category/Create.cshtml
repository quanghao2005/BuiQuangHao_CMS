@model CMS.Data.Entities.Category

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white py-3 text-center">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle"></i> THÊM DANH M?C M?I</h4>
                </div>
                <div class="card-body p-4">
                    @* CHU?N: G?i dúng Action Create v?i Method POST *@
                    <form asp-controller="Category" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        @* Hi?n th? danh sách l?i c? th? n?u h? th?ng t? ch?i luu *@
                        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                        @* Ô nh?p Tên danh m?c (Thêm name="Name" d? ép ép d? li?u truy?n di) *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Danh M?c:</label>
                            <input type="text" asp-for="Name" name="Name" class="form-control" placeholder="Ví d?: Công ngh? AI, Th? thao..." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        @* Ô nh?p Mô t? danh m?c (Thêm name="Description") *@
                        <div class="mb-4">
                            <label class="form-label fw-bold">Mô T?:</label>
                            <textarea asp-for="Description" name="Description" class="form-control" rows="3" placeholder="Nh?p mô t? ng?n..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        @* H? th?ng nút b?m *@
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left"></i> Quay l?i
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                                <i class="bi bi-save"></i> Luu D? Li?u
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
