@model CMS.Data.Entities.Banner
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thêm Banner Mới";
}

<div class="container-fluid mt-4">
    <div class="card shadow" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle"></i> THÊM BANNER MỚI</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề Banner (*)</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề banner" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Link Hình Ảnh (ImageUrl)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="Ví dụ: https://picsum.photos/1200/400" />
                    <div class="form-text">Nhập URL trực tiếp hoặc up ảnh lấy link để dán vào đây. Kích thước khuyên dùng: 1200x400px.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Link" class="form-label fw-bold">Đường dẫn khi Click (Link)</label>
                    <input asp-for="Link" class="form-control" placeholder="Ví dụ: /products/123" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-bold">Thứ tự hiển thị</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="1" />
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Kích hoạt hiển thị</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="/Banner" class="btn btn-secondary fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary fw-bold">Lưu Banner</button>
                </div>
            </form>
        </div>
    </div>
</div>
