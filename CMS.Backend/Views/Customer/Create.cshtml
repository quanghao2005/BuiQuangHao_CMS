@model CMS.Data.Entities.Customer

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-success text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill"></i> THÊM KHÁCH HÀNG M?I</h5>
        </div>

        <div class="card-body p-4 bg-white">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" value="0" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">H? và Tên khách hàng:</label>
                    <input type="text" asp-for="FullName" class="form-control" placeholder="Nh?p d?y d? h? tên..." required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ð?a ch? Email:</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="viethao@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">S? di?n tho?i:</label>
                    <input type="text" asp-for="Phone" class="form-control" placeholder="Nh?p s? di?n tho?i di d?ng..." required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">M?t kh?u dang nh?p:</label>
                    <input type="password" asp-for="Password" class="form-control" placeholder="Nh?p m?t kh?u tài kho?n..." required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left"></i> Quay l?i danh sách
                    </a>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-check-circle-fill"></i> Luu Khách Hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
